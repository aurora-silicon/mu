// SPDX-License-Identifier: BSD-2-Clause-Patent
//
// J804 GTDT: the architected timers as the carrier presents them. The
// carrier injects the EL1 physical timer as INTID 17 and the virtual timer as
// INTID 18 (hv_exc.c), level triggered, active high. No secure or EL2 timer
// is offered to the guest, no memory-mapped timer and no platform watchdog
// (WD1 stays with the carrier; it is the reset path).
//
#include <Library/AcpiLib.h>
#include <Library/PcdLib.h>
#include <IndustryStandard/Acpi64.h>
#include <Acpi/AcpiHeader.h>
#include <J804Windows.h>

STATIC_ASSERT (FixedPcdGet32 (PcdArmArchTimerIntrNum) == J804_TIMER_P_INTID,
  "PcdArmArchTimerIntrNum must match the carrier's physical timer INTID");
STATIC_ASSERT (FixedPcdGet32 (PcdArmArchTimerVirtIntrNum) == J804_TIMER_V_INTID,
  "PcdArmArchTimerVirtIntrNum must match the carrier's virtual timer INTID");

// Level triggered, active high, context lost in deep idle (flags all clear).
#define J804_TIMER_FLAGS  0

EFI_ACPI_6_4_GENERIC_TIMER_DESCRIPTION_TABLE  Gtdt = {
  .Header = __ACPI_HEADER (
              EFI_ACPI_6_4_GENERIC_TIMER_DESCRIPTION_TABLE_SIGNATURE,
              EFI_ACPI_6_4_GENERIC_TIMER_DESCRIPTION_TABLE,
              EFI_ACPI_6_4_GENERIC_TIMER_DESCRIPTION_TABLE_REVISION
              ),
  .CntControlBasePhysicalAddress = MAX_UINT64,
  .SecurePL1TimerGSIV            = 0,
  .SecurePL1TimerFlags           = 0,
  .NonSecurePL1TimerGSIV         = J804_TIMER_P_INTID,
  .NonSecurePL1TimerFlags        = J804_TIMER_FLAGS,
  .VirtualTimerGSIV              = J804_TIMER_V_INTID,
  .VirtualTimerFlags             = J804_TIMER_FLAGS,
  .NonSecurePL2TimerGSIV         = 0,
  .NonSecurePL2TimerFlags        = 0,
  .CntReadBasePhysicalAddress    = MAX_UINT64,
  .PlatformTimerCount            = 0,
  .PlatformTimerOffset           = 0,
  .VirtualPL2TimerGSIV           = 0,
  .VirtualPL2TimerFlags          = 0,
};

VOID *CONST  ReferenceAcpiTable = &Gtdt;
