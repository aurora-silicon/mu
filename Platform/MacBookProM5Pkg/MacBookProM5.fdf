!if $(J714_UEFI_KBL) == TRUE
  INF MacBookProM5Pkg/Drivers/J714KeyboardBacklightDxe/J714KeyboardBacklightDxe.inf
!endif

  INF MdeModulePkg/Universal/FvSimpleFileSystemDxe/FvSimpleFileSystemDxe.inf

!if $(MTP_HID_BUILD) == TRUE
