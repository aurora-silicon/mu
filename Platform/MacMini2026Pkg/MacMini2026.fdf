

[FD.J873MacMini2026_EFI]
BaseAddress   = 0x10300000000|gArmTokenSpaceGuid.PcdFdBaseAddress  # Desired address of firmware (will always be loaded from RAM)
Size          = 0x00001E00000|gArmTokenSpaceGuid.PcdFdSize         # The size in bytes
ErasePolarity = 1

BlockSize     = 0x4000
NumBlocks     = 0x780

0x000000000|0x000000100
DATA = {
  0x01, 0x00, 0x00, 0x10,                         # code0: adr x1, .
  0xff, 0x1f, 0x00, 0x14,                         # code1: b 0x8000
  0x00, 0x00, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, # text_offset: 512 KB
  0x00, 0x00, 0xe0, 0x01, 0x00, 0x00, 0x00, 0x00, # image_size: 30 MB
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, # flags
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, # res2
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, # res3
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, # res4
  0x41, 0x52, 0x4d, 0x64,                         # magic: "ARM\x64"
  0x00, 0x00, 0x00, 0x00                          # res5
}

0x000000100|0x000000010
DATA = {
  0x41, 0x55, 0x52, 0x41, 0x4e, 0x53, 0x4e, 0x56, # "AURANSNV"
  0x53, 0x41, 0x4e, 0x43, 0x48, 0x45, 0x43, 0x4b  # "SANCHECK"
}

0x000008000|0x001DF8000
gArmTokenSpaceGuid.PcdFvBaseAddress|gArmTokenSpaceGuid.PcdFvSize
FV = FVMAIN_COMPACT

[FV.FvMain]
BlockSize          = 0x40
FvAlignment        = 16         # FV alignment and FV attributes setting.
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE
FvNameGuid         = 84c90f2e-22a5-4c84-a199-a17f7ea7cf6d

  !include MacMini2026Pkg/DXEApriori.fdf.inc

  INF MdeModulePkg/Core/Dxe/DxeMain.inf

  INF MdeModulePkg/Universal/PCD/Dxe/Pcd.inf
