/** @file
  T6020/M2 Pro AIC2 Core System Resource Table.

  This is the Project Mu representation of the versioned, pointer-free ABI in
  drivers/AppleAic/aic2_csrt.h. Keep it byte-for-byte equivalent to the
  m2-pro fixture emitted by drivers/AppleAic/emit_aic2_csrt.c.

  SPDX-License-Identifier: MIT
**/

#include <Base.h>
#include <IndustryStandard/Acpi.h>

// Generated from artifacts/acpi/t6020-m2-pro-aic2/CSRT.bin. Keeping the
// complete table as bytes makes ABI drift mechanically detectable in host
// tests instead of relying on the host and Mu compilers to pack it alike.
//
// This table carries a trailing published-GSIV <-> physical-AIC-line alias
// section (the "ALI2" tail after the fixed 144-byte AIC2 payload). T6020's
// Left-front xHCI, ANS, right-side xHCI, and COM0 lines 1274/1832/1292/1198 sit in GIC's
// reserved 1024..4095 gap and are refused by Windows' PnP interrupt arbiter,
// so firmware publishes GSIVs 37/38/39/47. The GPU build additionally maps
// the AGX mailbox as 46 -> 1146.
// An older HAL or a CSRT without this tail parses as zero aliases and behaves
// identically to the original table.
//
// ONLY MCA0 REACHES THIS FILE.  The three media devices are three independent
// build flags, and exactly one of them changes a CSRT byte:
//
//   NTASI_ENABLE_MCA_PUBLICATION  MCA0's five AIC lines (1211-1231) are above
//                                 the GIC carrier's 1019 limit and are illegal
//                                 as GSIVs, so MCA0's _CRS publishes 40/41/42/
//                                 43/45 and the ALI2 tail below translates them.
//   NTASI_ENABLE_AOP_PUBLICATION  AOPA publishes AIC 631.  Below 1019, legal as
//                                 a GSIV, identity mapped, NO alias entry.
//   NTASI_ENABLE_ISP_PUBLICATION  ISP0 publishes AIC 569.  Same -- no entry.
//
// So the arms below key off NTASI_ENABLE_MCA_PUBLICATION alone.  A build with
// AOP and/or ISP on and MCA off carries a byte-for-byte unchanged CSRT, which
// is checked directly on the preprocessed bytes by
// Tests/test_j414s_media_acpi_contract.py rather than asserted here.
//
// The MCA table is a WHOLE separate alternative rather than more
// #if arms interleaved into the byte stream below, for two reasons: the
// existing text stays character-for-character untouched (so every non-MCA
// build is provably unchanged, not merely believed to be), and a 304-byte
// table whose length, checksum and three nested sub-lengths all move together
// is far safer transcribed as one block than as five correlated edits.
//
// Bytes generated by drivers/AppleAic/emit_aic2_csrt.c "m2-pro-media" and
// transcribed verbatim; sha256
// 0eeba7fd25f9c9838afa2a15883afeaa43a06b427662d00888edf16af88b4b91.
// The ordinary "m2-pro" table the #else arm carries is
// 97846e552ede9ae962c71ece4b6ca55fb0cb6b64a831be42794ba249b7277c22, which
// Tests/test_j414s_media_acpi_contract.py re-derives from this file and
// compares against the emitter, so neither arm can drift from the driver-side
// ABI without a test failure.
//
//
// EVERY published GSIV this SoC's firmware can emit, named once. The tables
// below are transcribed bytes, so these constants are not what builds them --
// they exist so the collision rule can be CHECKED at compile time instead of
// being asserted in a comment. Keep them in step with
// drivers/AppleAic/aic2_platform.h, which is what actually emits the bytes;
// Tests/test_j414s_gpu_acpi_contract.py pins the two against each other.
//
#define NTASI_CSRT_GSIV_XHC1        37   // -> 1274, boot USB
#define NTASI_CSRT_GSIV_ANS         38   // -> 1832
#define NTASI_CSRT_GSIV_XHC2        39   // -> 1292
#define NTASI_CSRT_GSIV_MCA_ADMAC   40   // -> 1218, MCA
#define NTASI_CSRT_GSIV_MCA_CL0     41   // -> 1211, MCA
#define NTASI_CSRT_GSIV_MCA_CL2     42   // -> 1213, MCA
#define NTASI_CSRT_GSIV_MCA_I2C2    43   // -> 1221, MCA
#define NTASI_CSRT_GSIV_SIO_DART    45   // -> 1231, MCA
#define NTASI_CSRT_GSIV_AGX_MAILBOX 46   // -> 1146, GPU
#define NTASI_CSRT_GSIV_COM0        47   // -> 1198, debug UART

//
// WHY THERE IS NO LONGER AN #error HERE, AND WHAT REPLACED IT.
//
// Until 2026-07-31 this file refused at compile time to build the MCA and
// GPU features together, because both claimed published GSIV 40: the AGX ASC
// mailbox (40 -> 1146) and admac-sio (40 -> 1218). One number cannot mean two
// physical lines.
//
// The collision is now GONE rather than merely refused: the AGX mailbox moved
// to published GSIV 46. The GPU alias moved rather than the audio one because
// MCA's 40..45 block is a shipped, documented allocation with pinned CSRT
// bytes and a driver-side _DSD, while the GPU alias had never been booted and
// is not read by AppleAgxGpu at all (it takes its GSIV from the _CRS interrupt
// descriptor). 46 was proven free against the pinned live ADT on all five
// allocation rules -- in particular it is claimed by NO ADT node, unlike 44
// (/arm-io/i2c0/hpmBusManager). See docs/j414s-media-gsiv-allocation.md.
//
// The #error is replaced by something STRICTER, not weaker. It only ever
// caught the one 40-vs-40 case, and only by assumption; the assertions below
// check that no two published GSIVs collide at all, pairwise, across every
// feature combination -- so a future edit that reintroduces ANY collision
// fails the build rather than silently emitting a table in which one published
// number means two lines. drivers/AppleAic/aic2_platform.c enforces the same
// invariant a second, independent time at emission
// (ntasi_aic2_t6020_aliases_are_wellformed() over the combined set), and the
// emitter refuses to write a table if it does not hold.
//
STATIC_ASSERT (
  NTASI_CSRT_GSIV_XHC1 != NTASI_CSRT_GSIV_ANS &&
  NTASI_CSRT_GSIV_XHC1 != NTASI_CSRT_GSIV_XHC2 &&
  NTASI_CSRT_GSIV_XHC1 != NTASI_CSRT_GSIV_MCA_ADMAC &&
  NTASI_CSRT_GSIV_XHC1 != NTASI_CSRT_GSIV_MCA_CL0 &&
  NTASI_CSRT_GSIV_XHC1 != NTASI_CSRT_GSIV_MCA_CL2 &&
  NTASI_CSRT_GSIV_XHC1 != NTASI_CSRT_GSIV_MCA_I2C2 &&
  NTASI_CSRT_GSIV_XHC1 != NTASI_CSRT_GSIV_SIO_DART &&
  NTASI_CSRT_GSIV_XHC1 != NTASI_CSRT_GSIV_AGX_MAILBOX &&
  NTASI_CSRT_GSIV_ANS != NTASI_CSRT_GSIV_XHC2 &&
  NTASI_CSRT_GSIV_ANS != NTASI_CSRT_GSIV_MCA_ADMAC &&
  NTASI_CSRT_GSIV_ANS != NTASI_CSRT_GSIV_MCA_CL0 &&
  NTASI_CSRT_GSIV_ANS != NTASI_CSRT_GSIV_MCA_CL2 &&
  NTASI_CSRT_GSIV_ANS != NTASI_CSRT_GSIV_MCA_I2C2 &&
  NTASI_CSRT_GSIV_ANS != NTASI_CSRT_GSIV_SIO_DART &&
  NTASI_CSRT_GSIV_ANS != NTASI_CSRT_GSIV_AGX_MAILBOX &&
  NTASI_CSRT_GSIV_XHC2 != NTASI_CSRT_GSIV_MCA_ADMAC &&
  NTASI_CSRT_GSIV_XHC2 != NTASI_CSRT_GSIV_MCA_CL0 &&
  NTASI_CSRT_GSIV_XHC2 != NTASI_CSRT_GSIV_MCA_CL2 &&
  NTASI_CSRT_GSIV_XHC2 != NTASI_CSRT_GSIV_MCA_I2C2 &&
  NTASI_CSRT_GSIV_XHC2 != NTASI_CSRT_GSIV_SIO_DART &&
  NTASI_CSRT_GSIV_XHC2 != NTASI_CSRT_GSIV_AGX_MAILBOX &&
  NTASI_CSRT_GSIV_MCA_ADMAC != NTASI_CSRT_GSIV_MCA_CL0 &&
  NTASI_CSRT_GSIV_MCA_ADMAC != NTASI_CSRT_GSIV_MCA_CL2 &&
  NTASI_CSRT_GSIV_MCA_ADMAC != NTASI_CSRT_GSIV_MCA_I2C2 &&
  NTASI_CSRT_GSIV_MCA_ADMAC != NTASI_CSRT_GSIV_SIO_DART &&
  NTASI_CSRT_GSIV_MCA_ADMAC != NTASI_CSRT_GSIV_AGX_MAILBOX &&
  NTASI_CSRT_GSIV_MCA_CL0 != NTASI_CSRT_GSIV_MCA_CL2 &&
  NTASI_CSRT_GSIV_MCA_CL0 != NTASI_CSRT_GSIV_MCA_I2C2 &&
  NTASI_CSRT_GSIV_MCA_CL0 != NTASI_CSRT_GSIV_SIO_DART &&
  NTASI_CSRT_GSIV_MCA_CL0 != NTASI_CSRT_GSIV_AGX_MAILBOX &&
  NTASI_CSRT_GSIV_MCA_CL2 != NTASI_CSRT_GSIV_MCA_I2C2 &&
  NTASI_CSRT_GSIV_MCA_CL2 != NTASI_CSRT_GSIV_SIO_DART &&
  NTASI_CSRT_GSIV_MCA_CL2 != NTASI_CSRT_GSIV_AGX_MAILBOX &&
  NTASI_CSRT_GSIV_MCA_I2C2 != NTASI_CSRT_GSIV_SIO_DART &&
  NTASI_CSRT_GSIV_MCA_I2C2 != NTASI_CSRT_GSIV_AGX_MAILBOX &&
  NTASI_CSRT_GSIV_SIO_DART != NTASI_CSRT_GSIV_AGX_MAILBOX &&
  NTASI_CSRT_GSIV_COM0 != NTASI_CSRT_GSIV_XHC1 &&
  NTASI_CSRT_GSIV_COM0 != NTASI_CSRT_GSIV_ANS &&
  NTASI_CSRT_GSIV_COM0 != NTASI_CSRT_GSIV_XHC2 &&
  NTASI_CSRT_GSIV_COM0 != NTASI_CSRT_GSIV_MCA_ADMAC &&
  NTASI_CSRT_GSIV_COM0 != NTASI_CSRT_GSIV_MCA_CL0 &&
  NTASI_CSRT_GSIV_COM0 != NTASI_CSRT_GSIV_MCA_CL2 &&
  NTASI_CSRT_GSIV_COM0 != NTASI_CSRT_GSIV_MCA_I2C2 &&
  NTASI_CSRT_GSIV_COM0 != NTASI_CSRT_GSIV_SIO_DART &&
  NTASI_CSRT_GSIV_COM0 != NTASI_CSRT_GSIV_AGX_MAILBOX,
  "two published GSIVs collide; one number would mean two physical AIC lines"
  );

//
// AIC 44 is a real line owned by /arm-io/i2c0/hpmBusManager in the live ADT.
// An early draft of the audio work proposed 44 -> 1231 and the allocation
// validator rejected it. Nothing may publish it, ever.
//
STATIC_ASSERT (
  NTASI_CSRT_GSIV_MCA_ADMAC != 44 && NTASI_CSRT_GSIV_MCA_CL0 != 44 &&
  NTASI_CSRT_GSIV_MCA_CL2 != 44 && NTASI_CSRT_GSIV_MCA_I2C2 != 44 &&
  NTASI_CSRT_GSIV_SIO_DART != 44 && NTASI_CSRT_GSIV_AGX_MAILBOX != 44 &&
  NTASI_CSRT_GSIV_XHC1 != 44 && NTASI_CSRT_GSIV_ANS != 44 &&
  NTASI_CSRT_GSIV_XHC2 != 44 && NTASI_CSRT_GSIV_COM0 != 44,
  "published GSIV 44 is a real AIC line owned by /arm-io/i2c0/hpmBusManager"
  );

#if NTASI_ENABLE_MCA_PUBLICATION && NTASI_GPU_RESOURCE_PROFILE
//
// MCA AND GPU: ten ALI2 aliases -- the nine MCA entries above plus the
// AGX mailbox (46 -> 1146). This is the table a baseline carrying ANS,
// wireless, MCA audio and GPU together needs, and it could not exist while the
// AGX mailbox and admac-sio both claimed published GSIV 40.
//
// Transcribed as ONE whole block rather than as #ifs interleaved into the
// MCA byte stream, for the reason stated above: a 312-byte table whose
// length, checksum and three nested sub-lengths all move together is far safer
// as one block than as five correlated edits. Bytes generated by
// drivers/AppleAic/emit_aic2_csrt.c "m2-pro-media-gpu" and transcribed
// verbatim; sha256
// 466c90641d5c9e05c430cd544b533ec485e7be254bf08c55a1500dbff2e6918a.
//
// A strict superset of the MCA table, which is itself a strict superset of
// the ordinary one, so the boot USB controller's 37 -> 1274 alias is
// bit-identical and still first in all four variants.
//
UINT8 Csrt[] = {
  0x43, 0x53, 0x52, 0x54, 0x38, 0x01, 0x00, 0x00,
  0x00, 0x19, 0x4e, 0x54, 0x41, 0x53, 0x49, 0x20,
  0x54, 0x36, 0x30, 0x32, 0x41, 0x49, 0x43, 0x32,
  0x01, 0x00, 0x00, 0x00, 0x4e, 0x54, 0x41, 0x53,
  0x01, 0x00, 0x00, 0x00, 0x14, 0x01, 0x00, 0x00,
  0x41, 0x50, 0x50, 0x4c, 0x4e, 0x54, 0x41, 0x53,
  0x08, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x00, 0x00, 0xfc, 0x00, 0x00, 0x00,
  0x01, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x41, 0x49, 0x43, 0x32, 0x90, 0x00, 0x00, 0x00,
  0x01, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00,
  0x07, 0x00, 0x00, 0x00, 0x20, 0x60, 0x00, 0x00,
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x10, 0x8e, 0x02, 0x00, 0x00, 0x00,
  0x00, 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x00, 0xc0, 0x10, 0x8e, 0x02, 0x00, 0x00, 0x00,
  0x00, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00,
  0x0c, 0x00, 0x00, 0x00, 0x00, 0x20, 0x00, 0x00,
  0x14, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00,
  0xa9, 0x07, 0x00, 0x00, 0x00, 0x10, 0x00, 0x00,
  0x01, 0x00, 0x00, 0x00, 0x08, 0x00, 0x00, 0x00,
  0x00, 0x4a, 0x00, 0x00, 0x00, 0x4a, 0x00, 0x00,
  0x00, 0x4a, 0x00, 0x00, 0x00, 0x4a, 0x00, 0x00,
  0x0c, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x41, 0x4c, 0x49, 0x32, 0x01, 0x00, 0x00, 0x00,
  0x0a, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x25, 0x00, 0x00, 0x00, 0xfa, 0x04, 0x00, 0x00,
  0x26, 0x00, 0x00, 0x00, 0x28, 0x07, 0x00, 0x00,
  0x27, 0x00, 0x00, 0x00, 0x0c, 0x05, 0x00, 0x00,
  0x2f, 0x00, 0x00, 0x00, 0xae, 0x04, 0x00, 0x00,
