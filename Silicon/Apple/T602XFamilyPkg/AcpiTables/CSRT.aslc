  // why NTASI_ENABLE_AOP_PUBLICATION and NTASI_ENABLE_ISP_PUBLICATION are not
  // consulted in this file: turning either on adds nothing here.
  //
  0x43, 0x53, 0x52, 0x54, 0x30, 0x01, 0x00, 0x00,
