/**
 * Processor Properties Topology Table for the Apple T8122 family.
 *
 * Generated by Tools/add-soc.py from the device tree for
 * Apple MacBook Air (13-inch, M3, 2024).
 *
 * Covers: t8122
 *
 * UNVERIFIED. Every address, core count and window below is what the device
 * tree states; none of it has been read off this silicon by us, and no machine
 * in this family has been booted. Treat a successful build as evidence that the
 * package is self-consistent and nothing more.
 *
 * Describes 1 die(s), 2 cluster(s) per die, 8 cores per die.
 *
 * SPDX-License-Identifier: BSD-2-Clause-Patent OR MIT
 */

#include <Library/AcpiLib.h>
#include <Library/ArmLib.h>
#include <Library/PcdLib.h>
#include <IndustryStandard/Acpi64.h>
#include <Acpi/AcpiHeader.h>
#include <Acpi/SgiAcpiHeader.h>
#include "T8122Topology.h"

#define DIE_COUNT  1

//
// UID bases per cluster, matching the MADT's GICC UIDs exactly. The DSDT's
// _UID values, the MADT and this table all have to agree or the OS cannot
// correlate a processor with its place in the topology.
//
#define CLUSTER_0_UID_BASE 0
#define CLUSTER_1_UID_BASE 4

#pragma pack(1)

typedef struct {
  EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR  Core;
} PPTT_CORE;

typedef struct {
  EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR  Cluster;
  PPTT_CORE                              Cores[4];
} PPTT_CLUSTER_0;
typedef struct {
  EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR  Cluster;
  PPTT_CORE                              Cores[4];
} PPTT_CLUSTER_1;

typedef struct {
  EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR  Die;
  PPTT_CLUSTER_0  Cluster0;
  PPTT_CLUSTER_1  Cluster1;
} PPTT_DIE;

typedef struct {
  EFI_ACPI_DESCRIPTION_HEADER  Header;
  PPTT_DIE                     Dies[DIE_COUNT];
} EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE;

#pragma pack ()

#define CORE_INIT(DieId, ClusterIdx, CpuId)                                         \
{                                                                                   \
  EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR_INIT (                                      \
    0x14,                                                  /* Length */             \
    PPTT_PROCESSOR_CORE_FLAGS,                             /* Flag */               \
    OFFSET_OF (EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE,                    \
      Dies[DieId].Cluster ## ClusterIdx),                  /* Parent */             \
    ((T8122_CPU_COUNT / DIE_COUNT) * (DieId)) +                                     \
      CLUSTER_ ## ClusterIdx ## _UID_BASE + (CpuId),       /* ACPI Id */            \
    0                                                      /* Private resources */  \
  ),                                                                                \
}

#define CLUSTER_0_INIT(DieId)                                                       \
{                                                                                   \
  EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR_INIT (                                      \
    OFFSET_OF (PPTT_CLUSTER_0, Cores),                    /* Length */              \
    PPTT_PROCESSOR_CLUSTER_FLAGS,                          /* Flag */               \
    OFFSET_OF (EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE,                    \
      Dies[DieId].Die),                                    /* Parent */             \
    (((DieId) << 4) | 0),                                  /* ACPI Id */            \
    0                                                      /* Private resources */  \
  ),                                                                                \
  {                                                                                 \
    CORE_INIT (DieId, 0, 0),                                                        \
    CORE_INIT (DieId, 0, 1),                                                        \
    CORE_INIT (DieId, 0, 2),                                                        \
    CORE_INIT (DieId, 0, 3)                                                         \
  }                                                                                 \
}

#define CLUSTER_1_INIT(DieId)                                                       \
{                                                                                   \
  EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR_INIT (                                      \
    OFFSET_OF (PPTT_CLUSTER_1, Cores),                    /* Length */              \
    PPTT_PROCESSOR_CLUSTER_FLAGS,                          /* Flag */               \
    OFFSET_OF (EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE,                    \
      Dies[DieId].Die),                                    /* Parent */             \
    (((DieId) << 4) | 1),                                  /* ACPI Id */            \
    0                                                      /* Private resources */  \
  ),                                                                                \
  {                                                                                 \
    CORE_INIT (DieId, 1, 0),                                                        \
    CORE_INIT (DieId, 1, 1),                                                        \
    CORE_INIT (DieId, 1, 2),                                                        \
    CORE_INIT (DieId, 1, 3)                                                         \
  }                                                                                 \
}

#define DIE_INIT(DieId)                                                             \
{                                                                                   \
  EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR_INIT (                                      \
    OFFSET_OF (PPTT_DIE, Cluster0),                        /* Length */             \
    PPTT_PROCESSOR_PACKAGE_FLAGS,                 /* Flag */                        \
    0,                                                     /* Parent */             \
    (DieId),                                               /* ACPI Id */            \
    0                                                      /* Private resources */  \
  ),                                                                                \
  CLUSTER_0_INIT (DieId),                                                           \
  CLUSTER_1_INIT (DieId)                                                            \
}

EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE  Pptt = {
  __ACPI_HEADER (
    EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_STRUCTURE_SIGNATURE,
    EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE,
    EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_REVISION
  ),
  {
  DIE_INIT (0)
  }
};

VOID *CONST  ReferenceAcpiTable = &Pptt;
