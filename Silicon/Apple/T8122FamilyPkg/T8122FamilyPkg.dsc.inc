#
# Apple T8122 SoC configuration.
#
#   Generated by Tools/add-soc.py from the device tree for
#   Apple MacBook Air (13-inch, M3, 2024).
#
#   Covers: t8122
#
#   UNVERIFIED. Every address, core count and window below is what the device
#   tree states; none of it has been read off this silicon by us, and no machine
#   in this family has been booted. Treat a successful build as evidence that the
#   package is self-consistent and nothing more.
#
# SPDX-License-Identifier: BSD-2-Clause-Patent
#

[PcdsPatchableInModule.common]
  #
  # Patched from the FDT at runtime. DRAM base is 0x800000000 on this family --
  # taken from the device tree's memory node, not inherited from a sibling SoC,
  # because the base moved between generations and the two proven families
  # disagree. Each platform defines T8122_SYSTEM_MEMORY_SIZE for its own
  # configuration before including this file.
  #
  gArmTokenSpaceGuid.PcdSystemMemoryBase|0x800000000
  gArmTokenSpaceGuid.PcdSystemMemorySize|$(T8122_SYSTEM_MEMORY_SIZE)
  gArmTokenSpaceGuid.PcdFdBaseAddress|0x0
  gArmTokenSpaceGuid.PcdFvBaseAddress|0x0
  gAppleSiliconPkgTokenSpaceGuid.PcdFrameBufferAddress|0x0
  gAppleSiliconPkgTokenSpaceGuid.PcdFrameBufferSize|0x0

[PcdsFixedAtBuild.common]
  #
  # Timer GSIVs. Arbitrary: on Apple silicon the architected timers are per-CPU
  # FIQs rather than GIC PPIs, so these numbers only have to agree between the
  # GTDT and whatever presents the interrupt.
  #
  gArmTokenSpaceGuid.PcdArmArchTimerSecIntrNum|19
  gArmTokenSpaceGuid.PcdArmArchTimerIntrNum|17
  gArmTokenSpaceGuid.PcdArmArchTimerHypIntrNum|20
  gArmTokenSpaceGuid.PcdArmArchTimerVirtIntrNum|18
  gAppleSiliconPkgTokenSpaceGuid.PcdAppleSartVersion|2

  #
  # Boot args and ADT pointers. These are FixedAtBuild -- unlike the memory base
  # above they are not patched at runtime, so a value outside DRAM is fatal
  # rather than merely wrong. DRAM + 0x220000000, the offset both proven
  # families use.
  #
  # UNVERIFIED: these must match where m1n1 actually deposits the boot args and
  # the ADT on this family. Inside DRAM is necessary, not sufficient.
  #
  gAppleSiliconPkgTokenSpaceGuid.PcdBootArgsPointer|0xA20000000
  gAppleSiliconPkgTokenSpaceGuid.PcdAdtPointer|0xA20004000
  gAppleSiliconPkgTokenSpaceGuid.PcdSmbiosCpuIdentifier|"T8122"
  gAppleSiliconPkgTokenSpaceGuid.PcdSmbiosCpuModel|"Apple M3"

  #
  # UART0, from the device tree's serial0 alias. Note this moves between
  # generations and even within one -- T6030 and T6031 are both M3-class and
  # put it 0x108000000 apart -- so it is never safe to inherit.
  #
  gAppleSiliconPkgTokenSpaceGuid.PcdAppleUartBase|0x2A1200000

  gAppleSiliconPkgTokenSpaceGuid.PcdAppleSocIdentifier|0x8122
  gAppleSiliconPkgTokenSpaceGuid.PcdInitializeRamdisk|TRUE

  #
  # SEC phase stack, DRAM + 12GB, matching both proven families.
  #
  gAppleSiliconPkgTokenSpaceGuid.PcdSecPhaseStackBase|0xB00000000

  gAppleSiliconPkgTokenSpaceGuid.PcdCoreCount|8|UINT32|0x00004406
  gAppleSiliconPkgTokenSpaceGuid.PcdClusterCount|2|UINT32|0x00004407

  #
  # Apple silicon has no GIC. m1n1's hv_vgicv3_init() installs distributor and
  # redistributor MMIO hooks at exactly these addresses on the native-AIC path,
  # so they describe what the guest is actually given. They are set for every
  # build, AIC included: the MADT describes a GICv3 unconditionally, and leaving
  # these at their UINT64 default of 0 does not omit the GIC, it publishes one
  # at physical address 0 -- which Windows believes, maps, and faults on.
  #
  gArmTokenSpaceGuid.PcdGicDistributorBase|0xf00000000
  gArmTokenSpaceGuid.PcdGicRedistributorsBase|0xf10000000
  gEfiMdeModulePkgTokenSpaceGuid.PcdAcpiDefaultOemRevision|0x00008122

!if $(SECURE_BOOT_ENABLE) == TRUE
  gEmbeddedTokenSpaceGuid.PcdMemoryTypeEfiRuntimeServicesData|600
  gEmbeddedTokenSpaceGuid.PcdMemoryTypeEfiRuntimeServicesCode|400
  gEmbeddedTokenSpaceGuid.PcdMemoryTypeEfiBootServicesCode|1500
!else
  gEmbeddedTokenSpaceGuid.PcdMemoryTypeEfiRuntimeServicesData|300
  gEmbeddedTokenSpaceGuid.PcdMemoryTypeEfiRuntimeServicesCode|150
  gEmbeddedTokenSpaceGuid.PcdMemoryTypeEfiBootServicesCode|1000
!endif
  gEmbeddedTokenSpaceGuid.PcdMemoryTypeEfiBootServicesData|800
  gEmbeddedTokenSpaceGuid.PcdMemoryTypeEfiLoaderCode|10
  gEmbeddedTokenSpaceGuid.PcdMemoryTypeEfiLoaderData|0
  gEmbeddedTokenSpaceGuid.PcdPrePiCpuIoSize|40

  gEfiMdeModulePkgTokenSpaceGuid.PcdSrIovSupport|FALSE
  gEfiMdeModulePkgTokenSpaceGuid.PcdAriSupport|FALSE
  gEfiMdeModulePkgTokenSpaceGuid.PcdMrIovSupport|FALSE

  #
  # PCIe, decoded from pcie@580000000 in the device tree.
  #
  # EDK2 convention: *Base is the bus/child address and *Translation is what
  # gets added to reach the CPU-physical address.
  #
  gArmTokenSpaceGuid.PcdPciBusMin|0x0
  gArmTokenSpaceGuid.PcdPciBusMax|0xFF
  gAppleSiliconPkgTokenSpaceGuid.PcdPciBusCount|0x100
  gArmTokenSpaceGuid.PcdPciIoBase|0x0
  gArmTokenSpaceGuid.PcdPciIoSize|0x00010000
  gEfiMdePkgTokenSpaceGuid.PcdPciIoTranslation|0x0

  # 32-bit window, not prefetchable: child 0xC0000000 -> cpu 0x5C0000000
  gArmTokenSpaceGuid.PcdPciMmio32Base|0xC0000000
  gArmTokenSpaceGuid.PcdPciMmio32Size|0x40000000
  gAppleSiliconPkgTokenSpaceGuid.PcdPciMmio32Limit|0xFFFFFFFF
  gEfiMdePkgTokenSpaceGuid.PcdPciMmio32Translation|0x500000000

  # 64-bit window, prefetchable: child 0x5A0000000 -> cpu 0x5A0000000 (1:1)
  gArmTokenSpaceGuid.PcdPciMmio64Base|0x5A0000000
  gArmTokenSpaceGuid.PcdPciMmio64Size|0x20000000
  gAppleSiliconPkgTokenSpaceGuid.PcdPciMmio64Limit|0x5BFFFFFFF
  gEfiMdePkgTokenSpaceGuid.PcdPciMmio64Translation|0x0

  # ECAM: pcie@580000000 reg[0], 0x1000000 of config space.
  gEfiMdePkgTokenSpaceGuid.PcdPciExpressBaseAddress|0x580000000
  gAppleSiliconPkgTokenSpaceGuid.PcdPciExpressBarSize|0x10000000
  gAppleSiliconPkgTokenSpaceGuid.PcdPciExpressBarLimit|0x58FFFFFFF

  gEmbeddedTokenSpaceGuid.PcdDmaDeviceOffset|0xFFFFFFFB00000000

