  "note": "The complete #include closure of every Mac device tree Asahi carries, plus the dt-bindings headers those trees include. Vendored whole so Tools/mkdtb.sh can compile any of them without a Linux checkout.",
  "authored": {
    "t8140-j700.dts": {
      "why": "Asahi has no t8140 tree -- the MacBook Neo is not a Mac they support. This one is assembled so T8140 goes through the same Tools/mkdtb.sh -> socfacts.py -> add-soc.py path as every other SoC instead of having its family package hand-written.",
      "source": "https://github.com/aurora-silicon/neo-bringup",
      "evidence": "docs/hardware-inventory.md, rows graded 'A; locally verified'",
      "also": [
        "dts/t8140-j700-uboot-smoke.dts (AIC event window)",
        "research/t8140-nvme-dma-permission-fault-audit-2026-08-14.md (ANS layout)"
      ],
      "note": "Every address is transcribed from a measurement on a live J700. PCIe is deliberately absent: no capture records a root complex address, and m1n1's t8140 support is ADT-index driven."
    }
  }
