 #include "DxeMain.h"
+#include <Library/AppleDTLib.h>
+
+//
+// J813 bring-up checkpoints.  The normal serial console is not available
+// until well into DXE, so leave a small row of framebuffer blocks after each
+// major DXE Core boundary.  This is intentionally write-only: it cannot alter
+// control flow, allocate memory, or depend on Boot Services being live.
+//
+STATIC
+VOID
+MuDxeVisualCheckpoint (
+  IN UINTN  Stage
+  )
+{
+  STATIC CONST UINT32  Colors[] = {
+    0x00FFFFFF,
+    0x0000FFFF,
+    0x0000FF00,
+    0x00FFFF00,
+    0x00FF8000,
+    0x00FF00FF,
+    0x00FF0000
+  };
+  CONST struct boot_args  *BootArgs;
+  volatile UINT32         *Row;
+  UINTN                   Index;
+  UINTN                   RowIndex;
+  UINTN                   X;
+  UINTN                   Y;
+  UINTN                   XStart;
+  UINTN                   YStart;
+
+  if ((Stage < 0x30) || (Stage > 0x3D)) {
+    return;
+  }
+
+  BootArgs = (CONST struct boot_args *)(UINTN)FixedPcdGet64 (PcdBootArgsPointer);
+  if ((BootArgs == NULL) || (BootArgs->video.base == 0) ||
+      (BootArgs->video.stride < sizeof (UINT32)) ||
+      (BootArgs->video.width < 448) || (BootArgs->video.height < 160)) {
+    return;
+  }
+
+  Index    = (Stage - 0x30) % ARRAY_SIZE (Colors);
+  RowIndex = (Stage - 0x30) / ARRAY_SIZE (Colors);
+  XStart   = 24 + (Index * 56);
+  YStart   = 88 + (RowIndex * 32);
+
+  for (Y = YStart; Y < (YStart + 24); Y++) {
+    Row = (volatile UINT32 *)(UINTN)(
+                                  BootArgs->video.base +
+                                  (Y * BootArgs->video.stride)
+                                  );
+    for (X = XStart; X < (XStart + 48); X++) {
+      Row[X] = Colors[Index];
+    }
+  }
+
+  MemoryFence ();
+}
 
