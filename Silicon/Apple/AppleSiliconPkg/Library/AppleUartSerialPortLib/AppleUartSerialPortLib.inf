# Apple UART Serial Port Library INF Description File
# SPDX-License-Identifier: BSD-2-Clause-Patent

[Defines]
  INF_VERSION    = 0x00010005
  FILE_GUID      = e27f53d5-a3a2-4db2-aaea-44045fc70f11
  BASE_NAME      = AppleUartSerialPortLib
  MODULE_TYPE    = BASE
  VERSION_STRING = 1.0
  LIBRARY_CLASS  = SerialPortLib

[Sources.common]
  AppleUartSerialPortLib.c

[Packages]
  MdePkg/MdePkg.dec
  ArmPkg/ArmPkg.dec
  AppleSiliconPkg/AppleSiliconPkg.dec

[LibraryClasses]
  ArmLib
  PcdLib
  IoLib
  HobLib
  CompilerIntrinsicsLib

[FixedPcd]
  gAppleSiliconPkgTokenSpaceGuid.PcdAppleUartBase
  gAppleSiliconPkgTokenSpaceGuid.PcdAppleUartMmioEnabled
  # Reported back from SerialPortSetAttributes(). The UART is fixed-configuration,
  # so these are what is actually in effect regardless of what a caller asks for.
  gEfiMdePkgTokenSpaceGuid.PcdUartDefaultBaudRate
  gEfiMdePkgTokenSpaceGuid.PcdUartDefaultDataBits
  gEfiMdePkgTokenSpaceGuid.PcdUartDefaultParity
  gEfiMdePkgTokenSpaceGuid.PcdUartDefaultStopBits
