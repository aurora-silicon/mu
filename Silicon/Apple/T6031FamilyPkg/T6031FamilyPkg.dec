  #   cluster 1: 6 x P-core
  #   cluster 2: 6 x P-core
  #
  gT6031FamilyPkgTokenSpaceGuid.PcdCoreCount|16|UINT32|0x00004406
  gT6031FamilyPkgTokenSpaceGuid.PcdClusterCount|3|UINT32|0x00004407
