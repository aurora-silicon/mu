/**
 * Multiple APIC Description Table for the Apple T8140 family.
 *
 * Generated by Tools/add-soc.py from the device tree for
 * Apple MacBook Neo.
 *
 * Covers: t8140
 *
 * UNVERIFIED. Every address, core count and window below is what the device
 * tree states; none of it has been read off this silicon by us, and no machine
 * in this family has been booted. Treat a successful build as evidence that the
 * package is self-consistent and nothing more.
 *
 * Copyright (c) 2026 Aurora Silicon
 * SPDX-License-Identifier: BSD-2-Clause-Patent OR MIT
 */

#include <Library/AcpiLib.h>
#include <Library/ArmLib.h>
#include <Library/PcdLib.h>
#include <IndustryStandard/Acpi63.h>
#include <Acpi/AcpiHeader.h>
#include "T8140Topology.h"

//
// PMU interrupt indices. Asahi's tree expresses these as AIC_CPU_PMU_E /
// AIC_CPU_PMU_P fiq-index affinities rather than plain GSIVs, so there is no
// number here to copy. 0 means "no PMU interrupt", which is the honest
// representation. Do not import the values from another SoC package.
//
#define T8140_PMU_IRQ_UNKNOWN 0

#define MADT_GICR_INIT()  {                                                    \
   EFI_ACPI_6_4_GICR,                        /* Type */                       \
   sizeof (EFI_ACPI_6_4_GICR_STRUCTURE),     /* Length */                     \
   EFI_ACPI_RESERVED_WORD,                   /* Reserved */                   \
   FixedPcdGet32 (PcdGicRedistributorsBase), /* DiscoveryRangeBaseAddress */  \
   0x20000 * FixedPcdGet32 (PcdCoreCount)    /* DiscoveryRangeLength */       \
}

#pragma pack (1)

typedef struct {
  EFI_ACPI_6_3_MULTIPLE_APIC_DESCRIPTION_TABLE_HEADER  Header;
  EFI_ACPI_6_3_GIC_STRUCTURE                           GicInterfaces[T8140_CPU_COUNT];
  EFI_ACPI_6_0_GIC_DISTRIBUTOR_STRUCTURE               GicDistributor;
  EFI_ACPI_6_4_GICR_STRUCTURE                          GicRedistributor;
  //
  // No GIC ITS entry. The distributor and redistributor above are emulated by
  // m1n1's vGIC carrier; the ITS is not -- its MMIO hook is compiled out
  // whenever the native-AIC bridge is in use, which is every configuration this
  // platform ships. Advertising one is not a harmless overstatement: Windows
  // initialises every ITS the MADT lists and the first register read lands on
  // an address with no stage-2 mapping, which ends the boot.
  //
  // It is also the accurate description of the machine. Apple silicon has no
  // GIC, MSIs are translated nowhere, and every peripheral interrupt -- PCIe
  // included -- arrives through AIC and is bridged as a wired interrupt.
  //
} MULTIPLE_APIC_DESCRIPTION_TABLE;

#pragma pack ()

MULTIPLE_APIC_DESCRIPTION_TABLE  Madt = {
  {
    __ACPI_HEADER (
      EFI_ACPI_6_3_MULTIPLE_APIC_DESCRIPTION_TABLE_SIGNATURE,
      MULTIPLE_APIC_DESCRIPTION_TABLE,
      EFI_ACPI_6_3_MULTIPLE_APIC_DESCRIPTION_TABLE_REVISION
    ),
    0, // LocalApicAddress
    0, // Flags
  },
  {
    //
    // EFI_ACPI_6_3_GICC_STRUCTURE_INIT(GicId, AcpiCpuUid, Mpidr, Flags, PmuIrq,
    //     GicBase, GicVBase, GicHBase, GsivId, GicRBase, Efficiency, SpeOvflIrq)
    //
    // The bootstrap processor's GICC must come first (ACPI 6.3 5.2.12.14).
    // UNVERIFIED which core that is on this family -- see T8140_BOOT_CPU_UID.
    //
    // The table is sized to the die. AcpiPlatformDxe removes entries for cores
    // the live ADT does not report before installing it, because leaving a
    // phantom core enabled makes Windows issue PSCI CPU_ON for it and answer
    // the failure with SYSTEM_RESET.
    //
    EFI_ACPI_6_3_GICC_STRUCTURE_INIT( // cluster 1 P-core 0
        4, 4, GET_MPIDR(0, 1, 1, 0), EFI_ACPI_6_3_GIC_ENABLED,
        T8140_PMU_IRQ_UNKNOWN, 0, 0, 0, 25, 0 /* GicRBase */, 1, 0),

    EFI_ACPI_6_3_GICC_STRUCTURE_INIT( // cluster 0 E-core 0
        0, 0, GET_MPIDR(0, 0, 0, 0), EFI_ACPI_6_3_GIC_ENABLED,
        T8140_PMU_IRQ_UNKNOWN, 0, 0, 0, 25, 0 /* GicRBase */, 0, 0),
    EFI_ACPI_6_3_GICC_STRUCTURE_INIT( // cluster 0 E-core 1
        1, 1, GET_MPIDR(0, 0, 0, 1), EFI_ACPI_6_3_GIC_ENABLED,
        T8140_PMU_IRQ_UNKNOWN, 0, 0, 0, 25, 0 /* GicRBase */, 0, 0),
    EFI_ACPI_6_3_GICC_STRUCTURE_INIT( // cluster 0 E-core 2
        2, 2, GET_MPIDR(0, 0, 0, 2), EFI_ACPI_6_3_GIC_ENABLED,
        T8140_PMU_IRQ_UNKNOWN, 0, 0, 0, 25, 0 /* GicRBase */, 0, 0),
    EFI_ACPI_6_3_GICC_STRUCTURE_INIT( // cluster 0 E-core 3
        3, 3, GET_MPIDR(0, 0, 0, 3), EFI_ACPI_6_3_GIC_ENABLED,
        T8140_PMU_IRQ_UNKNOWN, 0, 0, 0, 25, 0 /* GicRBase */, 0, 0),
    EFI_ACPI_6_3_GICC_STRUCTURE_INIT( // cluster 1 P-core 1
        5, 5, GET_MPIDR(0, 1, 1, 1), EFI_ACPI_6_3_GIC_ENABLED,
        T8140_PMU_IRQ_UNKNOWN, 0, 0, 0, 25, 0 /* GicRBase */, 1, 0),
  },
  EFI_ACPI_6_0_GIC_DISTRIBUTOR_INIT (0, FixedPcdGet64 (PcdGicDistributorBase), 0, 3),
  MADT_GICR_INIT ()
};

//
// Reference the table so the optimiser cannot drop it.
//
VOID *CONST  ReferenceAcpiTable = &Madt;
